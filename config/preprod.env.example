# Symbiotic v0.15.0 — Cardano Preprod only
SYMBIOTIC_CARDANO_NETWORK=preprod
SYMBIOTIC_TESTNET_MAGIC=1

# Independent chain providers. Put credentials in your secret manager, not this file.
SYMBIOTIC_PROVIDER_ENDPOINT=https://cardano-preprod.blockfrost.io/api/v0
SYMBIOTIC_INDEXER_ENDPOINT=https://preprod.koios.rest/api/v1
SYMBIOTIC_TX_BUILDER_ENDPOINT=https://your-builder.example.com/build

# Oracle source identifiers must map to independent source/signer/provider groups.
SYMBIOTIC_ORACLE_SOURCES=oracle-source-a,oracle-source-b

# Applied validator addresses/hashes — replace only with values generated from the exact v0.15.0 blueprint.
SYMBIOTIC_COLLATERAL_VALIDATOR_ADDRESS=
SYMBIOTIC_COLLATERAL_VALIDATOR_HASH=
SYMBIOTIC_COLLATERAL_REFERENCE_UTXO=

SYMBIOTIC_PERPETUAL_VALIDATOR_ADDRESS=
SYMBIOTIC_PERPETUAL_VALIDATOR_HASH=
SYMBIOTIC_PERPETUAL_REFERENCE_UTXO=

SYMBIOTIC_OPTIONS_VALIDATOR_ADDRESS=
SYMBIOTIC_OPTIONS_VALIDATOR_HASH=
SYMBIOTIC_OPTIONS_REFERENCE_UTXO=

SYMBIOTIC_NOTIONAL_VALIDATOR_ADDRESS=
SYMBIOTIC_NOTIONAL_VALIDATOR_HASH=
SYMBIOTIC_NOTIONAL_REFERENCE_UTXO=

SYMBIOTIC_REGISTRY_VALIDATOR_ADDRESS=
SYMBIOTIC_REGISTRY_VALIDATOR_HASH=
SYMBIOTIC_REGISTRY_REFERENCE_UTXO=

# V11 finalized-testnet evidence flags. These must only be set from persisted evidence produced by real Preprod transactions.
SYMBIOTIC_V11_PREPROD_PROFILE_VERIFIED=false
SYMBIOTIC_V11_PROVIDER_RECONCILIATION_VERIFIED=false
SYMBIOTIC_V11_WALLET_PREFLIGHT_VERIFIED=false
SYMBIOTIC_V11_DEPLOYMENT_MANIFEST_VERIFIED=false
SYMBIOTIC_V11_BUILDER_GATEWAY_VERIFIED=false
SYMBIOTIC_V11_PERP_LIFECYCLE_VERIFIED=false
SYMBIOTIC_V11_OPTIONS_LIFECYCLE_VERIFIED=false
SYMBIOTIC_V11_NOTIONAL_LIFECYCLE_VERIFIED=false
SYMBIOTIC_V11_OPERATOR_BINDINGS_VERIFIED=false
SYMBIOTIC_V11_FINALITY_RECONCILIATION_VERIFIED=false
SYMBIOTIC_V11_INDEXER_RECONCILIATION_VERIFIED=false
SYMBIOTIC_V11_FAILURE_SUITE_VERIFIED=false
SYMBIOTIC_V11_EVIDENCE_ROOT_VERIFIED=false
SYMBIOTIC_V11_FINALIZED=false
